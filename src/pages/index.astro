---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { resolveBlogLocaleMeta } from '../i18n/locale-config';
import { listLocalizedLocales } from '../lib/localizedBlog';

const rawPosts = await getCollection('blog');
const uniquePostsById = Array.from(new Map(rawPosts.map((post) => [post.id, post])).values());
// Further deduplicate by Title to catch different IDs with same content
const uniquePosts = Array.from(new Map(uniquePostsById.map((post) => [post.data.title, post])).values());

const allPosts = uniquePosts.sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const posts = allPosts;
const baseUrl = import.meta.env.BASE_URL ?? '/';
const normalizedBaseUrl = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const postHref = (slug) => `${normalizedBaseUrl}${slug}/`;
const localizedLocales = listLocalizedLocales();
const localeMeta = resolveBlogLocaleMeta('en');
const hreflangs = [
	{ lang: "en", path: normalizedBaseUrl },
	...localizedLocales.map((locale) => ({ lang: locale, path: `${normalizedBaseUrl}${locale}/` })),
	{ lang: "x-default", path: normalizedBaseUrl },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={SITE_TITLE}
			description={SITE_DESCRIPTION}
			canonicalPath={normalizedBaseUrl}
			hreflangs={hreflangs}
		/>
		<style>
			main {
				width: 1400px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 3rem 1rem;
			}
			
			.section-title {
				font-size: 2.5rem;
				font-weight: 800;
				margin-bottom: 2rem;
				color: var(--black);
			}

			ul {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
				gap: 2rem;
				list-style-type: none;
				padding: 0;
				margin: 0;
			}

			li {
				background: white;
				border-radius: 12px;
				overflow: hidden;
				transition: all 0.2s ease-in-out;
				box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
				display: flex;
				flex-direction: column;
			}

			li:hover {
				transform: translateY(-4px);
				box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
			}

			li a {
				text-decoration: none;
				color: inherit;
				display: flex;
				flex-direction: column;
				height: 100%;
			}

			.img-container {
				width: 100%;
				aspect-ratio: 16 / 9;
				background-color: rgb(var(--gray-light));
				overflow: hidden;
			}

			.img-container img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: transform 0.3s ease;
			}

			li:hover .img-container img {
				transform: scale(1.05);
			}

			.content-container {
				padding: 1.5rem;
				flex: 1;
				display: flex;
				flex-direction: column;
			}

			.title {
				font-size: 1.5rem;
				font-weight: 700;
				color: #111;
				margin: 0.5rem 0;
				line-height: 1.3;
				transition: color 0.2s;
			}

			li:hover .title {
				color: var(--accent);
			}

			.date {
				color: #666;
				font-size: 0.875rem;
				margin-bottom: 0.5rem;
				display: block;
			}

			.description {
				color: #4b5563;
				font-size: 1rem;
				line-height: 1.6;
				margin: 0;
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			.view-all-link {
				display: none;
			}

			@media (max-width: 720px) {
				ul {
					grid-template-columns: 1fr;
				}
				.title {
					font-size: 1.25rem;
				}
			}
		</style>
	</head>
	<body>
		<Header currentLocale="en" localeLinks={hreflangs.filter((item) => item.lang !== 'x-default')} />
		<main>
			<section>
				<h1 class="section-title">{localeMeta.articlesHeading}</h1>
				<ul>
					{
						posts.map((post) => {
							return (
								<li>
									<a href={postHref(post.slug || post.id)}>
										<div class="img-container">
                                            {post.data.heroImage ? (
                                                <Image 
                                                    src={post.data.heroImage} 
                                                    width={1020} 
                                                    height={510} 
                                                    alt={post.data.title} 
                                                    style="max-width: 100%; height: auto; object-fit: cover;"
                                                    loading="lazy"
                                                />
                                            ) : (
                                                <img 
                                                    width={720} 
                                                    height={360} 
                                                    src="/blog-placeholder-1.jpg"
                                                    alt={post.data.title} 
                                                    style="max-width: 100%; height: auto; object-fit: cover;"
                                                    loading="lazy" 
                                                />
                                            )}
										</div>
										<div class="content-container">
											<span class="date">
												<FormattedDate date={post.data.pubDate} locale="en" />
											</span>
											<h2 class="title">{post.data.title}</h2>
											<p class="description">{post.data.description}</p>
										</div>
									</a>
								</li>
							);
						})
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
