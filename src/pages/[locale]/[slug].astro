---
import { Marked } from "marked";
import { getShikiHighlighter } from "../../lib/shikiHighlighter";
import BlogPost from "../../layouts/BlogPost.astro";
import {
  listLocalizedLocales,
  listIndexedLocalizedLocalesForSlug,
  listLocalizedLocalesForSlug,
  listLocalizedPostsForLocale,
  listLocalizedSlugs,
  readLocalizedPost,
} from "../../lib/localizedBlog";
import { rewriteLocalizedBlogImageReferences } from "../../lib/blogAssets";
import { hasAuthoredGeoSection, readGeoBlock } from "../../lib/geoBlocks";
import { isBlogArticleIndexable, resolveBlogLocaleMeta } from "../../i18n/locale-config";
import { sanitizeLocalizedBlogHtml } from "../../lib/blogSecurity.mjs";

function escapeHtml(value) {
  return String(value)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");
}

export async function getStaticPaths() {
  const paths = [];
  for (const locale of listLocalizedLocales()) {
    for (const slug of listLocalizedSlugs(locale)) {
      const payload = readLocalizedPost(locale, slug);
      if (!payload || payload.status !== "translated") {
        continue;
      }
      paths.push({
        params: { locale, slug },
        props: {
          locale,
          localizedLocalesForSlug: listLocalizedLocalesForSlug(slug),
          post: payload,
        },
      });
    }
  }
  return paths;
}

const { locale, localizedLocalesForSlug, post } = Astro.props;
const localeMeta = resolveBlogLocaleMeta(locale);
const pubDate = new Date(post.frontmatter.pubDate || Date.now());
const updatedDate = post.frontmatter.updatedDate ? new Date(post.frontmatter.updatedDate) : undefined;

// Get the Shiki highlighter singleton instance
const shikiHighlighter = await getShikiHighlighter();

const markedInstance = new Marked({
  renderer: {
    code({ text, lang }) {
      try {
        const cleanLang = (lang || "").toLowerCase().trim();
        if (cleanLang === "mermaid") {
          return `<pre class="mermaid">${escapeHtml(text)}</pre>`;
        }
        return shikiHighlighter.codeToHtml(text, {
          lang: cleanLang || "plaintext",
          theme: "github-dark"
        });
      } catch (e) {
        return `<pre><code>${escapeHtml(text)}</code></pre>`;
      }
    }
  }
});

const html = sanitizeLocalizedBlogHtml(
  await markedInstance.parse(rewriteLocalizedBlogImageReferences(post.body || "")),
);
const geoBlock = readGeoBlock(locale, post.slug);
const visibleGeoBlock = hasAuthoredGeoSection(post.body || "", geoBlock) ? null : geoBlock;
const baseUrl = import.meta.env.BASE_URL ?? "/";
const normalizedBaseUrl = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
const canonicalPath = `${normalizedBaseUrl}${locale}/${post.slug}/`;
const isIndexedArticle = isBlogArticleIndexable(locale, post.slug);
const indexedLocalizedLocalesForSlug = listIndexedLocalizedLocalesForSlug(post.slug);
const relatedPosts = listLocalizedPostsForLocale(locale)
  .filter((item) => item.slug !== post.slug)
  .slice(0, 3);
const localeLinks = [
  { lang: "en", path: `${normalizedBaseUrl}${post.slug}/` },
  ...localizedLocalesForSlug.map((item) => ({
    lang: item,
    path: `${normalizedBaseUrl}${item}/${post.slug}/`,
  })),
  { lang: "x-default", path: `${normalizedBaseUrl}${post.slug}/` },
];
const hreflangs = [
  { lang: "en", path: `${normalizedBaseUrl}${post.slug}/` },
  ...indexedLocalizedLocalesForSlug.map((item) => ({
    lang: item,
    path: `${normalizedBaseUrl}${item}/${post.slug}/`,
  })),
  { lang: "x-default", path: `${normalizedBaseUrl}${post.slug}/` },
];
---

<BlogPost
  lang={locale}
  slug={post.slug}
  title={post.frontmatter.title}
  description={post.frontmatter.description}
  pubDate={pubDate}
  updatedDate={updatedDate}
  heroImage={post.frontmatter.heroImage}
  heroImageAlt={post.frontmatter.heroImageAlt}
  canonicalPath={canonicalPath}
  hreflangs={hreflangs}
  localeLinks={localeLinks}
  faqItems={visibleGeoBlock?.faq ?? []}
  robots={isIndexedArticle ? undefined : "noindex,follow"}
>
  <div set:html={html} />
  {
    visibleGeoBlock && (
      <section>
        <h2>{visibleGeoBlock.sectionTitles?.keyTakeaways || "Key Takeaways"}</h2>
        <ul>
          {visibleGeoBlock.keyTakeaways.slice(0, 4).map((item) => <li>{item}</li>)}
        </ul>
        <h2>{visibleGeoBlock.sectionTitles?.faq || "FAQ"}</h2>
        {visibleGeoBlock.faq.slice(0, 4).map((item) => (
          <div>
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </div>
        ))}
        <h2>{visibleGeoBlock.sectionTitles?.glossary || "Glossary"}</h2>
        <ul>
          {visibleGeoBlock.glossary.slice(0, 5).map((item) => (
            <li><strong>{item.term}:</strong> {item.definition}</li>
          ))}
        </ul>
      </section>
    )
  }
  <section>
    <h2>{geoBlock?.sectionTitles?.related || localeMeta.relatedArticles}</h2>
    <ul>
      {relatedPosts.map((item) => (
        <li><a href={`${normalizedBaseUrl}${locale}/${item.slug}/`}>{item.frontmatter?.title || item.slug}</a></li>
      ))}
    </ul>
  </section>
</BlogPost>
