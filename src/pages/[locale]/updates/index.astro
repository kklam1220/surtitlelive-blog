---
import { getCollection } from 'astro:content';
import ProductUpdatesPage from '../../../components/ProductUpdatesPage.astro';
import { listIndexedLocalizedLocales, listLocalizedLocales } from '../../../lib/localizedBlog';

export function getStaticPaths() {
	return listLocalizedLocales().map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props;
const entry = (await getCollection('updates')).find((item) => item.data.locale === locale);
if (!entry) throw new Error(`Missing ${locale} Product Updates content.`);
const baseUrl = import.meta.env.BASE_URL ?? '/';
const normalizedBaseUrl = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const canonicalPath = `${normalizedBaseUrl}${locale}/updates/`;
const englishPath = `${normalizedBaseUrl}updates/`;
const hreflangs = [
	{ lang: 'en', path: englishPath },
	...listIndexedLocalizedLocales().map((item) => ({ lang: item, path: `${normalizedBaseUrl}${item}/updates/` })),
	{ lang: 'x-default', path: englishPath },
];
const localeLinks = [
	{ lang: 'en', path: englishPath },
	...listLocalizedLocales().map((item) => ({ lang: item, path: `${normalizedBaseUrl}${item}/updates/` })),
	{ lang: 'x-default', path: englishPath },
];
---

<ProductUpdatesPage
	{entry}
	{canonicalPath}
	articlesHref={`${normalizedBaseUrl}${locale}/`}
	updatesHref={canonicalPath}
	{hreflangs}
	{localeLinks}
/>
