---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { buildMainSiteHref } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Page not found | SurtitleLive Blog"
			description="The requested SurtitleLive Blog page could not be found."
			canonicalPath="/blog/404/"
			robots="noindex, nofollow"
		/>
	</head>
	<body>
		<Header currentLocale="en" />
		<main>
			<p class="eyebrow">404</p>
			<h1>Page not found</h1>
			<p>The article or page you requested does not exist.</p>
			<div class="actions">
				<a class="primary" href="/blog/">Browse SurtitleLive articles</a>
				<a href={buildMainSiteHref('/')}>Return to SurtitleLive</a>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	body {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	main {
		width: min(720px, calc(100% - 2rem));
		margin: auto;
		padding: 5rem 1rem;
		text-align: center;
	}

	.eyebrow {
		margin: 0;
		color: var(--accent);
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	h1 {
		font-size: clamp(2.5rem, 8vw, 4.5rem);
		margin: 0.5rem 0 1rem;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem;
		margin-top: 2rem;
	}

	.actions a {
		border: 1px solid var(--accent);
		border-radius: 999px;
		padding: 0.75rem 1.25rem;
		text-decoration: none;
	}

	.actions .primary {
		background: var(--accent);
		color: white;
	}
</style>
