---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_TITLE } from '../consts';

type MetaImage = Pick<ImageMetadata, 'src'>;

interface Props {
	title: string;
	description: string;
	image?: MetaImage;
	canonicalPath?: string;
	hreflangs?: Array<{ lang: string; path: string }>;
}

const {
	title,
	description,
	image = FallbackImage,
	canonicalPath = Astro.url.pathname,
	hreflangs = [],
} = Astro.props;

const canonicalURL = new URL(canonicalPath, Astro.site);
const baseUrl = import.meta.env.BASE_URL ?? '/';
const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const rssUrl = new URL(`${normalizedBase}rss.xml`, Astro.site);
const sitemapUrl = new URL(`${normalizedBase}sitemap-index.xml`, Astro.site);
const regularFontUrl = new URL(`${normalizedBase}fonts/atkinson-regular.woff`, Astro.site);
const boldFontUrl = new URL(`${normalizedBase}fonts/atkinson-bold.woff`, Astro.site);
const fontFaceStyles = `
	@font-face {
		font-family: 'Atkinson Hyperlegible';
		src: url('${regularFontUrl.toString()}') format('woff');
		font-weight: 400;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: 'Atkinson Hyperlegible';
		src: url('${boldFontUrl.toString()}') format('woff');
		font-weight: 700;
		font-style: normal;
		font-display: swap;
	}
`;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href={`${normalizedBase}favicon.ico`} />
<link rel="icon" type="image/png" sizes="192x192" href={`${normalizedBase}favicon-192.png`} />
<link rel="sitemap" href={sitemapUrl} />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={rssUrl}
/>
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link rel="preload" href={regularFontUrl} as="font" type="font/woff" crossorigin />
<link rel="preload" href={boldFontUrl} as="font" type="font/woff" crossorigin />
<style is:inline set:html={fontFaceStyles} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />
{
	hreflangs.map((item) => (
		<link rel="alternate" hreflang={item.lang} href={new URL(item.path, Astro.site)} />
	))
}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL.href} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL.href} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image.src, Astro.url)} />
