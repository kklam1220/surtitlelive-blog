---
import HeaderLink from './HeaderLink.astro';
import LanguageSelector from './LanguageSelector.astro';
import { buildMainSiteHref, MAIN_SITE_URL } from '../consts';
import { isBlogSupportedLocale, resolveBlogNavCopy } from '../i18n/locale-config';

type LocaleLink = {
	lang: string;
	path: string;
};

interface Props {
	currentLocale?: string;
	localeLinks?: LocaleLink[];
}

const { currentLocale = 'en', localeLinks = [] } = Astro.props;
const baseUrl = import.meta.env.BASE_URL ?? '/';
const normalizedBaseUrl = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const logoHref = new URL('/logo/pockitle-cue-logo-header-480w.png', MAIN_SITE_URL).toString();
const navLocale = isBlogSupportedLocale(currentLocale) ? currentLocale : 'en';
const navCopy = resolveBlogNavCopy(navLocale);
const hasLocaleOptions = localeLinks.filter((item) => isBlogSupportedLocale(item.lang)).length > 1;

const localizedMainHref = (path = '/') => {
	const normalizedPath = path.startsWith('/') ? path : `/${path}`;

	if (normalizedPath.startsWith('/auth/')) {
		return buildMainSiteHref(normalizedPath);
	}

	if (navLocale === 'en') {
		return buildMainSiteHref(normalizedPath);
	}

	return buildMainSiteHref(normalizedPath === '/' ? `/${navLocale}` : `/${navLocale}${normalizedPath}`);
};

const localizedBlogHref = navLocale === 'en' ? normalizedBaseUrl : `${normalizedBaseUrl}${navLocale}/`;
---

<header>
	<nav>
		<div class="nav-brand">
			<div class="logo-container">
				<a href={localizedMainHref('/')} aria-label={navCopy.homeAria}>
					<img src={logoHref} alt={navCopy.logoAlt} height="44" />
				</a>
				<span class="logo-formerly">formerly SurtitleLive</span>
			</div>

			<button class="mobile-menu-toggle" aria-label={`${navCopy.features}, ${navCopy.pricing}, ${navCopy.resources}`} aria-expanded="false">
				<svg class="hamburger-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
				</svg>
				<svg class="close-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="display: none;">
					<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
				</svg>
			</button>
		</div>
		
		<div class="nav-menu">
			<div class="internal-links">
				<details class="nav-dropdown">
					<summary>{navCopy.features}</summary>
					<div class="dropdown-panel">
						<a href={localizedMainHref('/features')}>{navCopy.allProducts}</a>
						<a href={localizedMainHref('/workflow')}>{navCopy.workflow}</a>
						<a href={localizedMainHref('/pockitle-cue-for-mac')}>{navCopy.cueMac}</a>
						<a href={localizedMainHref('/qlab')}>{navCopy.qlabSurtitles}</a>
						<a href={navLocale === 'en' ? 'https://pockitle.com/live' : `https://pockitle.com/${navLocale}/live`}>{navCopy.live}</a>
					</div>
				</details>
				<a href={localizedMainHref('/pricing')}>{navCopy.pricing}</a>
				<details class="nav-dropdown">
					<summary>{navCopy.resources}</summary>
					<div class="dropdown-panel">
						<a href={localizedMainHref('/planning')}>{navCopy.planning}</a>
						<a href={localizedMainHref('/guides')}>{navCopy.guides}</a>
					</div>
				</details>
				<HeaderLink href={localizedBlogHref}>{navCopy.blog}</HeaderLink>
				<a href={localizedMainHref('/contact')}>{navCopy.contactUs}</a>
			</div>

			<div class="mobile-divider"></div>

			<div class="mobile-account">
				{hasLocaleOptions && (
					<div class="mobile-section">
						<div class="mobile-section-title">{navCopy.language}</div>
						<LanguageSelector currentLocale={currentLocale} localeLinks={localeLinks} />
					</div>
				)}
				<div class="mobile-section">
					<div class="mobile-section-title">{navCopy.account}</div>
					<a href={buildMainSiteHref('/auth/login')} class="login-link">{navCopy.login}</a>
					<a href={buildMainSiteHref('/auth/register')} class="signup-btn">{navCopy.signUp}</a>
				</div>
			</div>
		</div>

		<div class="auth-buttons">
			{hasLocaleOptions && <div class="desktop-language"><LanguageSelector currentLocale={currentLocale} localeLinks={localeLinks} /></div>}
			<a href={buildMainSiteHref('/auth/login')} class="login-link">{navCopy.login}</a>
			<a href={buildMainSiteHref('/auth/register')} class="signup-btn">{navCopy.signUp}</a>
		</div>
	</nav>
</header>

<script>
	const toggleBtn = document.querySelector('.mobile-menu-toggle');
	const navMenu = document.querySelector('.nav-menu');
	
	if (toggleBtn && navMenu) {
		toggleBtn.addEventListener('click', () => {
			const isOpen = navMenu.classList.contains('open');
			if (isOpen) {
				navMenu.classList.remove('open');
				toggleBtn.classList.remove('open');
				toggleBtn.setAttribute('aria-expanded', 'false');
			} else {
				navMenu.classList.add('open');
				toggleBtn.classList.add('open');
				toggleBtn.setAttribute('aria-expanded', 'true');
			}
		});
	}
</script>

<style>
	header {
		margin: 0;
		padding: 0;
		background: rgba(255, 255, 255, 0.9);
		backdrop-filter: blur(4px);
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	nav {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: center;
		justify-content: space-between;
		padding: 1rem 1.5rem;
		max-width: 1280px;
		margin: 0 auto;
		gap: 1.5rem;
		box-sizing: border-box;
	}
	.nav-brand {
		display: contents;
	}
	.logo-container {
		grid-column: 1;
		justify-self: start;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
	}
	.internal-links > a,
	.login-link {
		padding: 0;
	}
	.logo-container a {
		display: inline-flex;
	}
	.logo-container img {
		display: block;
		height: 36px;
		width: auto;
	}
	.logo-formerly {
		color: #6b7280;
		font-size: 0.6rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1;
		padding-right: 0.25rem;
	}
	.nav-menu {
		display: contents;
	}
	.internal-links {
		grid-column: 2;
		justify-self: center;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 2rem;
	}
	.internal-links a {
		color: #374151;
		font-weight: 500;
		text-decoration: none;
		font-size: 0.875rem; /* Match text-sm (14px) */
	}
	.internal-links a:hover,
	.internal-links a.active,
	.nav-dropdown summary:hover {
		color: black;
	}
	.nav-dropdown {
		position: relative;
	}
	.nav-dropdown summary {
		color: #374151;
		cursor: pointer;
		font-size: 0.875rem;
		font-weight: 500;
		list-style: none;
		white-space: nowrap;
	}
	.nav-dropdown summary::-webkit-details-marker {
		display: none;
	}
	.nav-dropdown summary::after {
		content: '';
		display: inline-block;
		width: 0.4rem;
		height: 0.4rem;
		margin-inline-start: 0.55rem;
		border-right: 1.5px solid #9ca3af;
		border-bottom: 1.5px solid #9ca3af;
		transform: translateY(-2px) rotate(45deg);
	}
	.dropdown-panel {
		position: absolute;
		inset-block-start: calc(100% + 0.8rem);
		inset-inline-start: 0;
		z-index: 25;
		min-width: 220px;
		padding: 0.5rem;
		border: 1px solid #e5e7eb;
		border-radius: 1rem;
		background: white;
		box-shadow: 0 12px 28px rgba(0, 0, 0, 0.12);
	}
	.dropdown-panel a {
		display: block;
		padding: 0.75rem 0.9rem;
		border-radius: 0.75rem;
		white-space: nowrap;
	}
	.dropdown-panel a:hover {
		background: #f9fafb;
	}
	.mobile-account {
		display: none;
	}
	.auth-buttons {
		grid-column: 3;
		justify-self: end;
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}
	.mobile-menu-toggle {
		display: none;
	}
	.login-link {
		color: #374151;
		font-weight: 500;
		font-size: 0.875rem; /* Match text-sm (14px) */
		text-decoration: none;
	}
	.login-link:hover {
		color: black;
	}
	.signup-btn {
		background-color: black;
		color: white !important;
		padding: 0.5rem 1rem;
		border-radius: 0.375rem;
		font-weight: 600;
		font-size: 0.875rem; /* Match text-sm (14px) */
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.12);
		transition: background-color 0.2s;
		text-decoration: none;
	}
	.signup-btn:hover {
		background-color: #333;
		color: white;
		text-decoration: none;
	}

	.mobile-menu-toggle,
	.mobile-divider,
	.mobile-section-title {
	display: none;
	}

	/* Keep the desktop links centered in the viewport, independent of the
	 * different widths of the logo and account controls.  The intermediate
	 * layout remains flex-based so links cannot collide on narrower screens. */
	@media (max-width: 1279px) {
		nav {
			grid-template-columns: minmax(0, 1fr) auto auto;
			gap: 1rem;
		}
		.nav-brand {
			display: contents;
		}
		.logo-container {
			grid-column: 1;
			grid-row: 1;
		}
		.logo-container img {
			height: 36px;
		}
		.mobile-menu-toggle {
			grid-column: 3;
			grid-row: 1;
			display: block;
			background: none;
			border: none;
			padding: 0.5rem;
			cursor: pointer;
			color: #4b5563;
		}
		.mobile-menu-toggle svg {
			width: 2rem;
			height: 2rem;
		}
		.mobile-menu-toggle.open .hamburger-icon {
			display: none;
		}
		.mobile-menu-toggle.open .close-icon {
			display: block !important;
		}

		.nav-menu {
			display: none;
			grid-column: 1 / -1;
			grid-row: 2;
			flex-direction: column;
			width: 100%;
			gap: 0.75rem;
			padding-top: 1rem;
			border-top: 1px solid #f3f4f6;
			margin-top: 1rem;
			flex: none;
		}
		.nav-menu.open {
			display: flex;
		}

		.internal-links {
			flex-direction: column;
			align-items: stretch;
			width: 100%;
			gap: 0.35rem;
		}
		.internal-links > a,
		.nav-dropdown summary {
			display: flex !important;
			align-items: center;
			justify-content: space-between;
			padding: 0.85rem 1rem;
			border-radius: 12px;
			font-size: 1rem;
			font-weight: 500;
			color: #374151;
			width: 100%;
			box-sizing: border-box;
			transition: background-color 0.2s, color 0.2s;
		}
		.internal-links a:hover,
		.internal-links a.active,
		.nav-dropdown summary:hover {
			background-color: #f9fafb;
			color: black;
		}
		.nav-dropdown {
			width: 100%;
		}
		.nav-dropdown summary {
			font-size: 1rem;
			padding: 0.85rem 1rem;
		}
		.dropdown-panel {
			position: static;
			min-width: 0;
			margin: 0.15rem 0 0.4rem;
			padding: 0.2rem 0 0.2rem 0.75rem;
			border: 0;
			border-inline-start: 1px solid #e5e7eb;
			border-radius: 0;
			box-shadow: none;
		}
		.dropdown-panel a {
			white-space: normal;
		}
		.mobile-divider {
			display: block;
			height: 1px;
			background-color: #f3f4f6;
			width: 100%;
			margin: 0.5rem 0;
		}

	}
	@media (min-width: 768px) and (max-width: 1279px) {
		.auth-buttons {
			grid-column: 2;
			grid-row: 1;
			gap: 1rem;
		}
		.nav-menu {
			grid-column: 1 / -1;
		}
		.mobile-account {
			display: none;
		}
	}
	@media (max-width: 767px) {
		nav {
			grid-template-columns: minmax(0, 1fr) auto;
			gap: 0.75rem;
		}
		.logo-container img {
			height: 28px;
		}
		.mobile-menu-toggle {
			grid-column: 2;
		}
		.auth-buttons {
			display: none;
		}
		.mobile-divider {
			display: block;
			height: 1px;
			background-color: #f3f4f6;
			width: 100%;
			margin: 0.5rem 0;
		}
		.mobile-account {
			display: flex;
			flex-direction: column;
			gap: 1rem;
			width: 100%;
		}
		.mobile-section {
			display: flex;
			flex-direction: column;
			gap: 0.75rem;
			width: 100%;
		}
		.mobile-section-title {
			display: block;
			font-size: 0.75rem;
			font-weight: 600;
			color: #9ca3af;
			text-transform: uppercase;
			letter-spacing: 0.05em;
			padding-left: 0.5rem;
		}
		.mobile-account .login-link,
		.mobile-account .signup-btn {
			display: flex;
			justify-content: center;
			width: 100%;
			padding: 0.85rem 1rem;
			border-radius: 0.75rem;
			box-sizing: border-box;
		}
		.mobile-account .login-link {
			border: 1px solid #e5e7eb;
			background-color: #f9fafb;
		}
	}
</style>
