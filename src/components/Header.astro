---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<div class="logo-container">
			<a href="https://www.surtitlelive.com" aria-label="SurtitleLive home">
				<img src="/logo/New_logo.png" alt="SurtitleLive Logo" height="50" style="height: 50px; width: auto;" />
			</a>
		</div>
		
		<div class="internal-links">
			<a href="https://www.surtitlelive.com/features">Features</a>
			<a href="https://www.surtitlelive.com/pricing">Pricing</a>
			<HeaderLink href="/">Blog</HeaderLink>
			<a href="https://www.surtitlelive.com/contact">Contact Us</a>
		</div>

		<div class="auth-buttons">
			<a href="https://www.surtitlelive.com/auth/login" class="login-link">Login</a>
			<a href="https://www.surtitlelive.com/auth/register" class="signup-btn">Sign Up</a>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1rem 2rem;
		max-width: 1400px;
		margin: 0 auto;
	}
	.internal-links {
		display: flex;
		gap: 2rem;
	}
	.internal-links a {
		color: #374151;
		font-weight: 500;
		text-decoration: none;
		font-size: 0.875rem; /* Match text-sm (14px) */
	}
	.internal-links a:hover, .internal-links a.active {
		color: black;
	}
	.auth-buttons {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}
	.login-link {
		color: #374151;
		font-weight: 500;
		font-size: 0.875rem; /* Match text-sm (14px) */
	}
	.login-link:hover {
		color: black;
	}
	.signup-btn {
		background-color: black;
		color: white;
		padding: 0.5rem 1.2rem;
		border-radius: 6px;
		font-weight: 600;
		font-size: 0.875rem; /* Match text-sm (14px) */
		transition: background-color 0.2s;
	}
	.signup-btn:hover {
		background-color: #333;
		color: white;
		text-decoration: none;
	}

	@media (max-width: 720px) {
		nav {
			flex-direction: column;
			gap: 1rem;
		}
		.internal-links {
			font-size: 0.9em;
			gap: 1rem;
		}
		.auth-buttons {
			display: none; /* Simplify for mobile for now */
		}
	}
</style>
