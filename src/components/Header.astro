---
import { statSync } from 'node:fs';
import HeaderLink from './HeaderLink.astro';
import LanguageSelector from './LanguageSelector.astro';
import { buildMainSiteHref } from '../consts';

type LocaleLink = {
	lang: string;
	path: string;
};

interface Props {
	currentLocale?: string;
	localeLinks?: LocaleLink[];
}

const { currentLocale = 'en', localeLinks = [] } = Astro.props;
const baseUrl = import.meta.env.BASE_URL ?? '/';
const normalizedBaseUrl = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const logoAssetPath = new URL('../../public/blog/logo/New_logo.png', import.meta.url);
const redirectsContractPath = new URL('../../public/_redirects', import.meta.url);
const chromeAssetVersion = Math.max(
	statSync(logoAssetPath).mtimeMs,
	statSync(redirectsContractPath).mtimeMs,
).toString(36);
const logoHref = `${normalizedBaseUrl}logo/New_logo.png?v=${chromeAssetVersion}`;
---

<header>
	<nav>
		<div class="logo-container">
			<a href={buildMainSiteHref('/')} aria-label="SurtitleLive home">
				<img src={logoHref} alt="SurtitleLive Logo" height="50" style="height: 50px; width: auto;" />
			</a>
		</div>
		
		<div class="internal-links">
			<a href={buildMainSiteHref('/features')}>Features</a>
			<a href={buildMainSiteHref('/pricing')}>Pricing</a>
			<a href={buildMainSiteHref('/guides')}>Guides</a>
			<HeaderLink href={normalizedBaseUrl}>Blog</HeaderLink>
			<a href={buildMainSiteHref('/contact')}>Contact Us</a>
		</div>

		<div class="auth-buttons">
			<LanguageSelector currentLocale={currentLocale} localeLinks={localeLinks} />
			<a href={buildMainSiteHref('/auth/login')} class="login-link">Login</a>
			<a href={buildMainSiteHref('/auth/register')} class="signup-btn">Sign Up</a>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1rem 2rem;
		max-width: 1400px;
		margin: 0 auto;
	}
	.internal-links {
		display: flex;
		gap: 2rem;
		align-items: center;
	}
	.internal-links a {
		color: #374151;
		font-weight: 500;
		text-decoration: none;
		font-size: 0.875rem; /* Match text-sm (14px) */
	}
	.internal-links a:hover, .internal-links a.active {
		color: black;
	}
	.auth-buttons {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}
	.login-link {
		color: #374151;
		font-weight: 500;
		font-size: 0.875rem; /* Match text-sm (14px) */
	}
	.login-link:hover {
		color: black;
	}
	.signup-btn {
		background-color: black;
		color: white;
		padding: 0.5rem 1.2rem;
		border-radius: 6px;
		font-weight: 600;
		font-size: 0.875rem; /* Match text-sm (14px) */
		transition: background-color 0.2s;
	}
	.signup-btn:hover {
		background-color: #333;
		color: white;
		text-decoration: none;
	}

	@media (max-width: 720px) {
		nav {
			flex-direction: column;
			gap: 1rem;
		}
		.internal-links {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			width: 100%;
			text-align: center;
			font-size: 0.9em;
			gap: 1rem;
		}
		.auth-buttons {
			display: flex;
			flex-direction: column;
			width: 100%;
			gap: 0.75rem;
		}
		.login-link,
		.signup-btn {
			display: flex;
			justify-content: center;
			width: 100%;
		}
	}
</style>
