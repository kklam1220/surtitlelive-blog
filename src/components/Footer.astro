---
const today = new Date();
---

<footer>
	<div class="container">
		<p>&copy; {today.getFullYear()} SurtitleLive. All rights reserved.</p>
		<div class="links">
			<a href="https://www.surtitlelive.com/privacy">Privacy</a>
			<a href="https://www.surtitlelive.com/terms">Terms</a>
			<a href="https://www.surtitlelive.com/viewer-agreement">Viewer Agreement</a>
			<a href="https://www.surtitlelive.com/contact">Contact</a>
		</div>
	</div>
</footer>

<style>
	footer {
		background-color: black;
		color: white;
		padding: 3rem 1rem;
		text-align: center;
		margin-top: auto; /* Push to bottom */
	}
	.container {
		max-width: 1200px;
		margin: 0 auto;
	}
	p {
		color: #9ca3af; /* gray-400 */
		margin-bottom: 1.5rem;
	}
	.links {
		display: flex;
		justify-content: center;
		gap: 2rem;
	}
	a {
		color: #9ca3af;
		text-decoration: none;
		transition: color 0.2s;
	}
	a:hover {
		color: #facc15; /* yellow-400 */
	}
</style>
