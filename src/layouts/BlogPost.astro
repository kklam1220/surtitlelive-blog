---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { resolveBlogLocaleMeta } from '../i18n/locale-config';
import { resolveBlogImage } from '../lib/blogAssets';

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type HeroImage = ImageMetadata | string;

type Props = Omit<CollectionEntry<'blog'>['data'], 'heroImage'> & {
	heroImage?: HeroImage;
	heroImageAlt?: string;
	robots?: string;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	heroImageAlt,
	slug = "",
	lang = "en",
	canonicalPath,
	hreflangs = [],
	localeLinks = hreflangs,
	faqItems = [],
	robots,
} = Astro.props;

const localeMeta = resolveBlogLocaleMeta(lang);
const canonicalURL = new URL(canonicalPath || Astro.url.pathname, Astro.site);
const resolvedHeroImage = typeof heroImage === 'string' ? resolveBlogImage(heroImage) : heroImage;
const metaImage = resolvedHeroImage ?? (typeof heroImage === 'string' ? { src: heroImage } : heroImage);
const renderableHeroImage = resolvedHeroImage;
const socialImageURL = new URL(metaImage?.src ?? '/blog-placeholder-1.jpg', Astro.url);


const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "datePublished": pubDate.toISOString(),
  "dateModified": updatedDate ? updatedDate.toISOString() : pubDate.toISOString(),
  "description": description,
  "inLanguage": lang,
  "image": socialImageURL.href,
  "author": {
    "@type": "Organization",
    "name": "SurtitleLive"
  },
  "publisher": {
    "@type": "Organization",
    "name": "SurtitleLive",
    "logo": {
        "@type": "ImageObject",
        "url": "https://surtitlelive.com/logo/New_logo.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalURL.href
  }
});

const generatedFaqSchema = Array.isArray(faqItems) && faqItems.length > 0
	? {
		"@context": "https://schema.org",
		"@type": "FAQPage",
		"inLanguage": lang,
		"mainEntity": faqItems
			.filter((item) => item?.question && item?.answer)
			.slice(0, 8)
			.map((item) => ({
				"@type": "Question",
				"name": item.question,
				"acceptedAnswer": {
					"@type": "Answer",
					"text": item.answer,
				},
			})),
	}
	: null;

const fullSchema = [
	JSON.parse(schema),
	...(generatedFaqSchema && generatedFaqSchema.mainEntity.length > 0 ? [generatedFaqSchema] : []),
];
---

<html lang={lang} dir={localeMeta.dir}>
		<head>
			<BaseHead
				title={title}
				description={description}
				image={metaImage}
				canonicalPath={canonicalPath}
				hreflangs={hreflangs}
				robots={robots}
			/>
			<script type="application/ld+json" set:html={JSON.stringify(fullSchema)} />
			<style>
				main {
					width: calc(100% - 2em);
					max-width: 100%;
					margin: 0;
				}
				.hero-image {
					width: 100%;
				}
				.hero-image img {
					display: block;
					margin: 0 auto;
					border-radius: 12px;
					box-shadow: var(--box-shadow);
					max-width: 100%;
					height: auto;
				}
				.prose {
					width: 860px;
					max-width: calc(100% - 2em);
					margin: auto;
					padding: 3rem 1rem;
					color: rgb(var(--gray-dark));
				}
				.title {
					margin-bottom: 2em;
					padding: 0;
					text-align: left;
					line-height: 1;
				}
				.title h1 {
					margin: 0.5rem 0 0.5em 0;
					font-size: 1.8em;
					font-weight: 800;
				}
				.date {
					margin-bottom: 0.5em;
					color: rgb(var(--gray));
					font-size: 0.95rem;
				}
				.last-updated-on {
					font-style: italic;
				}
			</style>
	</head>

	<body>
		<Header currentLocale={lang} localeLinks={localeLinks.filter((item) => item.lang !== 'x-default')} />
		<main>
			<article>
				<div class="hero-image">
					{renderableHeroImage && <Image width={1020} height={510} src={renderableHeroImage} alt={heroImageAlt || title} />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} locale={lang} />
							{
								updatedDate && (
									<div class="last-updated-on">
										{localeMeta.lastUpdatedOn} <FormattedDate date={updatedDate} locale={lang} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
		<script is:inline src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"></script>
		<script is:inline>
		  document.addEventListener("DOMContentLoaded", () => {
		    const codeBlocks = document.querySelectorAll("pre code.language-mermaid");
		    codeBlocks.forEach((codeBlock) => {
		      const pre = codeBlock.parentElement;
		      const div = document.createElement("div");
		      div.className = "mermaid";
		      div.textContent = codeBlock.textContent;
		      pre.replaceWith(div);
		    });
		    mermaid.initialize({ startOnLoad: true, theme: 'neutral' });
		  });
		</script>
	</body>
</html>
